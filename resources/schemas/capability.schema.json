{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LOUTE Capability Schema 2",
  "type": "object",
  "required": ["schema","id","phase","label","summary","inputs","provider","args","output","risk","noise","mitre","platforms","privileges","timeout","parser"],
  "properties": {
    "schema": { "type": "integer", "const": 2 },
    "id": { "type": "string", "maxLength": 40, "pattern": "^[a-z0-9_.-]+$" },
    "phase": { "type": "string", "enum": ["recon","surface","vulnerability","payload","escalation","credentials","lateral","persistence","exploitation","wireless","ctf"] },
    "label": { "type": "string" },
    "summary": { "type": "string" },
    "risk": { "type": "string", "enum": ["R0","R1","R2","R3","R4"] },
    "noise": { "type": "string", "enum": ["silent","low","medium","high","screaming"] },
    "mitre": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" }, "minItems": 1 },
    "platforms": { "type": "array", "items": { "type": "string", "enum": ["linux","android","windows","macos"] }, "minItems": 1 },
    "privileges": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "requires": { "type": "array", "items": { "type": "string" } },
    "provides": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "array", "items": { "type": "object", "required": ["key","type","required"], "properties": {
      "key": { "type": "string" }, "type": { "type": "string" }, "required": { "type": "boolean" }, "default": { "type": "string" }
    } } },
    "provider": { "type": "string" },
    "binary": { "type": "string" },
    "operation": { "type": "string" },
    "args": { "type": "array", "items": { "type": "string" } },
    "output": { "type": "string", "enum": ["lines","json"] },
    "parser": { "type": "string" },
    "line_schema": { "type": "object" },
    "json_schema": { "type": "object" },
    "probe": { "type": "array", "items": { "type": "string" } },
    "timeout": { "type": "integer", "minimum": 5, "maximum": 86400 },
    "retry": { "type": "integer", "minimum": 0, "maximum": 10 },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
    "cache_ttl": { "type": "integer", "minimum": 0 },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "reversible": { "type": "boolean" },
    "cleanup": { "type": "string" },
    "chains": { "type": "array", "items": { "type": "string" } },
    "opsec_safe": { "type": "boolean" },
    "native": { "type": "boolean" },
    "shell_escape": { "type": "boolean" },
    "network": { "type": "boolean" }
  }
}
